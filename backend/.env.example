# Copy to backend/.env and adjust. Every value is optional; the defaults below are what the server uses without it.
# Never put real secrets in this file: DEMO_KEY is left empty here on purpose.

PORT=3000
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_WS_URL=wss://broker.hivemq.com:8884/mqtt
TOPIC_PREFIX=siren-polnes26

# Priority trigger
RADIUS_M=1000
ETA_LEAD_S=40
PASS_M=50
PASS_HYSTERESIS_M=20
STOP_RELEASE_S=180

# Failsafe timing
TTL_S=15
REFRESH_S=5
STALE_S=15

# Access
MISSION_CODES=DEMO-112
# Panel Demo key; empty = panel disabled (the keyless "Mulai demo" button also needs it set).
DEMO_KEY=
