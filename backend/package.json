{
  "name": "siren-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "sim": "node scripts/sim.ts",
    "train:eta": "node scripts/train-eta.ts",
    "test": "node --test \"src/**/*.test.ts\" ../dashboard/signals.test.js",
    "typecheck": "tsc"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mqtt": "^5.16.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.5",
    "typescript": "^7.0.2"
  }
}
